<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%@ · %lld 次 · 输入 %@ · 输出 %@</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%@ · %lld 次 · 輸入 %@ · 輸出 %@</string>
	</dict>
	<key>%lld token</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%lld token</string>
	</dict>
	<key>%lld 个题集</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%lld 個題集</string>
	</dict>
	<key>%lld 个题集、%lld 篇笔记</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%lld 個題集、%lld 篇筆記</string>
	</dict>
	<key>%lld 个题集（%lld 道题）、%lld 篇笔记</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%lld 個題集（%lld 道題）、%lld 篇筆記</string>
	</dict>
	<key>%lld 周前</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%lld 星期前</string>
	</dict>
	<key>%lld 块</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%lld 塊</string>
	</dict>
	<key>%lld 块 · %lld 道练习</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%lld 塊 · %lld 道練習</string>
	</dict>
	<key>%lld 张图片</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%lld 張圖片</string>
	</dict>
	<key>%lld 篇笔记</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%lld 篇筆記</string>
	</dict>
	<key>%lld 轮就做对了，已移出错题本。</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%lld 輪就做對了，已移出錯題本。</string>
	</dict>
	<key>%lld 道题 · 已完成 %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%lld 道題 · 已完成 %lld</string>
	</dict>
	<key>%lld 页文字，约 %lld 字</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%lld 頁文字，約 %lld 字</string>
	</dict>
	<key>PDF 有 %lld 页，按图片识别最多支持 %lld 页，请拆分后再导入。</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>PDF 有 %lld 頁，按圖片識別最多支援 %lld 頁，請拆分後再匯入。</string>
	</dict>
	<key>做了 %lld 道题 · 作答 %lld 次 · 做对 %lld 次 · 提示 %lld 次</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>做了 %lld 道題 · 作答 %lld 次 · 做對 %lld 次 · 提示 %lld 次</string>
	</dict>
	<key>做题时点题目右上角的“错题”，把需要重点复习的题加进来。
在错题本里 %lld 轮之内做对，就会自动移出。</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>做題時點題目右上角的「錯題」，把需要重點溫習的題加進來。
在錯題本裏 %lld 輪之內做對，就會自動移出。</string>
	</dict>
	<key>其中 %lld 个题集本机已经有了，作为副本导入（名称后面带“导入”）。</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>其中 %lld 個題集本機已經有了，作為副本匯入（名稱後面帶「匯入」）。</string>
	</dict>
	<key>出 %lld 道</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>出 %lld 道</string>
	</dict>
	<key>可以重新练一遍：%lld 轮之内做对，就从错题本移出</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>可以重新練一遍：%lld 輪之內做對，就從錯題本移出</string>
	</dict>
	<key>复习中 · 已用 %lld 轮</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>溫習中 · 已用 %lld 輪</string>
	</dict>
	<key>已写好 %lld 块</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>已寫好 %lld 塊</string>
	</dict>
	<key>已导入 %lld 个题集，共 %lld 道题</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>已匯入 %lld 個題集，共 %lld 道題</string>
	</dict>
	<key>已擦掉 %lld 处</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>已擦掉 %lld 處</string>
	</dict>
	<key>已获取 %lld 个模型</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>已取得 %lld 個模型</string>
	</dict>
	<key>已获取 %lld 个模型，其中 %lld 个可以用来做题</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>已取得 %lld 個模型，其中 %lld 個可以用來做題</string>
	</dict>
	<key>已识别 %lld 道题</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>已識別 %lld 道題</string>
	</dict>
	<key>正在出 %lld 道题…</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>正在出 %lld 道題…</string>
	</dict>
	<key>请针对这一小节的内容出 %lld 道练习题。</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>請針對這一小節的內容出 %lld 道練習題。</string>
	</dict>
	<key>这次用了 %lld 轮，先留在错题本里，下次再练一遍。</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>這次用了 %lld 輪，先留在錯題本裏，下次再練一遍。</string>
	</dict>
	<key>错题复习中 · %lld 轮之内做对就移出错题本（检查一次或提示一次算一轮）</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>錯題溫習中 · %lld 輪之內做對就移出錯題本（檢查一次或提示一次算一輪）</string>
	</dict>
	<key>错题复习中 · 已用 %lld 轮</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>錯題溫習中 · 已用 %lld 輪</string>
	</dict>
	<key>，以及 %lld 篇笔记，都放在左侧列表的最上面。</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>，以及 %lld 篇筆記，都放在左側列表的最上面。</string>
	</dict>
</dict>
</plist>
